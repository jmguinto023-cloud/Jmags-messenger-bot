# ──────────────────────────────────────────────────────────────────────────────
# JMAG's Messenger bot – settings. Copy to .env for local runs, or type these
# into the hosting dashboard (Render → Environment). Never share real values.
# ──────────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────────
# Port the web server listens on. Render sets this automatically.
PORT=3000
# Folder for chat history + handoff status (a JSON file). On Render use the disk: /data
DATA_DIR=./data
# debug | info | warn | error | silent
LOG_LEVEL=info

# Chats with no activity for this many days are deleted automatically (privacy). 0 = keep.
DATA_RETENTION_DAYS=90

# ── Meta (Facebook) – from Jm's developer app ─────────────────────────────────
# Any long random password YOU make up. Type the same text into the app's webhook
# "Verify token" box. Meta uses it once to confirm the webhook URL is ours.
VERIFY_TOKEN=
# App ID: App Dashboard → App settings → Basic. Used to tell the bot's own messages
# apart from Ivan's replies.
APP_ID=
# App Secret: App Dashboard → App settings → Basic → "Show". SECRET. Used to check that
# every webhook really comes from Meta (X-Hub-Signature-256).
APP_SECRET=
# JMAG's Facebook Page ID.
PAGE_ID=102622881557025
# Page access token for the JMAG's Page (generated in the app's Messenger settings).
# SECRET. Lets the bot send replies and pass chats to the Page Inbox.
PAGE_ACCESS_TOKEN=
# Graph API version. Leave as is unless Meta retires it.
GRAPH_API_VERSION=v26.0
# Only change for testing against a mock server.
GRAPH_API_BASE=https://graph.facebook.com
# Meta's fixed app ID for the Page Inbox (Business Suite inbox). Handoffs go here.
PAGE_INBOX_APP_ID=263902037430900
# Optional: comma-separated app IDs whose Page messages should NOT pause the bot
# (e.g. another automation tool). Leave empty normally.
IGNORE_ECHO_APP_IDS=
# Optional: comma-separated app IDs of Meta's own inbox automations (not a person
# typing in Page Inbox). Echoes from these ids are logged with app_id and do NOT
# pause the bot for HUMAN_PAUSE_HOURS. Leave empty until the id is confirmed.
PAGE_AI_APP_IDS=
# Page Inbox label applied on handoff, and also when a customer sends a photo or video.
# A name is created via the Graph custom_labels API if it does not exist. A numeric value is used as the label id.
# Empty: handoff does not label; a photo or video still uses "Video for review".
NEEDS_IVAN_LABEL=

# ── AI model – any OpenAI-compatible "chat completions" API ───────────────────
# Base URL of the provider, ending before /chat/completions.
# Examples: https://api.openai.com/v1  ·  https://api.x.ai/v1  ·  https://openrouter.ai/api/v1
LLM_BASE_URL=
# API key from the AI provider. SECRET.
LLM_API_KEY=
# Model name from the provider (exact text they list).
LLM_MODEL=
# Give up on the AI after this many ms and send the canned Ivan-style message.
# Keep under 25000 so the reply still lands within Meta's 30-second rule.
LLM_TIMEOUT_MS=20000
# Lower = more consistent wording. 0.2–0.5 is good for a CSR. Use 'off' to never send the field.
# If the model returns HTTP 400 because temperature is deprecated, the bot retries once
# without it and then leaves it off for the rest of the process.
LLM_TEMPERATURE=0.4
# Max length of one AI reply (tokens). 0 = don't send the field (some models reject it).
LLM_MAX_TOKENS=400
# How many LLM calls per minute, shared by replies and follow-ups. Default 8.
# A customer reply is sent before a queued follow-up. 0 turns the gap off.
LLM_MAX_RPM=8
# The Ivan-style instructions. Default: prompts/system-prompt.md
# (refresh it from ../ivan-bot-system-prompt.md with: npm run sync-prompt)
SYSTEM_PROMPT_FILE=

# ── Safety switches ───────────────────────────────────────────────────────────
# Master switch. false = bot receives and logs messages but never replies.
BOT_ENABLED=false
# Testing: comma-separated customer IDs (PSIDs) the bot may reply to. Everyone else
# is ignored. Leave EMPTY only when going live. PSIDs show in the server log as the
# last 4 digits; full IDs are in data/state.json.
BOT_TEST_PSIDS=
# Soft launch: only reply during these hours (Philippine time). Overnight ranges OK.
# Example after-hours only: 18:00-08:00
# Empty = always on. The process logs hours=24/7. Follow-ups are not limited by these hours.
BOT_ACTIVE_HOURS=
# Built-in reply window, Asia/Manila, so the bot does not need an outside timer.
# Example night shift: 22:00-07:00. A window may cross midnight.
# Empty = reply whenever BOT_ENABLED is on. Outside the window the bot logs messages
# and the dashboard still works, but it sends no auto replies and no follow-ups.
# BOT_ENABLED=false is always off, even inside the window.
BOT_SCHEDULE=
# Days when the bot is on all day regardless of BOT_ACTIVE_HOURS. Example: sat,sun
BOT_ALWAYS_ON_DAYS=
# Time zone for the hours above.
BOT_TIMEZONE=Asia/Manila

# ── Behaviour ─────────────────────────────────────────────────────────────────
# How many back-and-forth turns of each chat the AI sees.
HISTORY_TURNS=20
# Schedule form link pasted into the system prompt. The "cutomer" spelling is the live site.
BOOKING_FORM_URL=https://jmagscutomerform.netlify.app/
# When Ivan (or anyone) replies from the Page, the bot stays quiet in that chat this long.
HUMAN_PAUSE_HOURS=12
# After a handoff, the bot stays silent in that chat until Ivan passes it back, or until
# the customer writes again this many hours later (a new inquiry). 0 = never auto-resume.
HANDOFF_RESUME_HOURS=72
# Wait this long for more messages before replying, so 3 quick messages get 1 answer.
BATCH_WINDOW_MS=3000
# Do not reply to a message older than this (Meta allows 24h; we keep a safety margin).
REPLY_WINDOW_HOURS=23.5
# Quiet-customer follow-up. Minutes of silence after the bot's last reply before the first nudge.
# A second nudge is about 24h after the first, still inside 23h of the customer's last message.
# 0 follow-ups max turns the scheduler off.
FOLLOWUP_AFTER_MIN=120
FOLLOWUP_MAX=2
# Skip a quiet-customer follow-up when their last message is older than this many hours.
FOLLOWUP_MAX_AGE_HOURS=6
# After the bot's video reply, if the customer stays quiet. First nudge at 30 minutes.
# Second nudge is this many minutes after the first. 0 disables the second. Not sent 9 PM–7 AM Manila.
VIDEO_FOLLOWUP_MINUTES=30
VIDEO_FOLLOWUP2_MINUTES=240
# Morning status text for Under Repair jobs that are linked to a Messenger chat.
# Off until you approve the sample message. true/1/on turns it on. Empty stays off.
# Sends from about 8:00 until 19:00 Asia/Manila, once per day, inside the reply window.
DAILY_STATUS_UPDATES=
# One text when a linked job changes to For Delivery. Off until you approve it. Empty stays off.
DELIVERY_NOTIFICATIONS=
# Optional. POST {psid, type, url, snippet, timestamp} when a customer sends a photo or video.
ALERT_WEBHOOK_URL=
# Web Push for /dashboard (installable "JMAG's Video Review"). Leave empty to disable alerts.
# Generate a pair with: npx web-push generate-vapid-keys
# Put the public key in VAPID_PUBLIC_KEY and the private key in VAPID_PRIVATE_KEY. Never commit the private key.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact URI required by the push service. mailto: or an https URL.
VAPID_SUBJECT=mailto:bot@jmags.local
# Comma-separated words that make the bot hand off immediately (customer wants a person).
# Default: tao,agent,tawag,tawagan,tumawag,call,ivan,human,real person,totoong tao,makausap,customer service
HANDOFF_KEYWORDS=
# Optional password for the admin endpoints:
#   POST /admin/resume?psid=...  (lets the bot answer a chat again)
#   POST /admin/forget?psid=...  (deletes one customer's stored chat – for deletion requests)
#   GET  /admin/conversations?since=ISO  (conversation export for weekly review)
# Send header: Authorization: Bearer <ADMIN_TOKEN>. Empty = admin endpoints disabled.
ADMIN_TOKEN=
# Password for GET /dashboard (Ivan's video review page). The login form sets an HttpOnly cookie.
# On Render this is generated. Empty = the dashboard stays locked.
DASHBOARD_PASSWORD=
# Optional. Replaces the one-time free-tips message sent when a video, location, and TV age are all in.
# Use \n for line breaks. Empty keeps the built-in tips, including 09386369374 (Smart) and 09267229506 (Globe).
TIPS_MESSAGE=
